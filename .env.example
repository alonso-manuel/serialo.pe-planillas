APP_NAME="Serialo Planillas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=serialo_planillas
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Boletas por correo: máximo de correos por minuto (límite del hosting)
PLANILLAS_CORREOS_POR_MINUTO=20

# Política de privacidad: quién es el responsable de los datos y el correo para derechos ARCO
# PLANILLAS_LEGAL_RESPONSABLE="Estudio Contable Ejemplo S.A.C."
# PLANILLAS_LEGAL_CORREO=privacidad@ejemplo.pe

# unica (hosting del cliente) o saas (VPS de Serialo.pe, un estudio por subdominio). Ver docs/multitenant.md
PLANILLAS_MODO=unica
# Solo en saas:
# PLANILLAS_DOMINIOS_CENTRALES=serialo.pe,admin.serialo.pe
# PLANILLAS_PREFIJO_BD=planillas_
# PLANILLAS_DOMINIO_PANEL=admin.serialo.pe
# PLANILLAS_URL_ESTUDIO=https://{estudio}.serialo.pe

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Consulta de RUC: openruc (gratis; con token, RUC 10 vía Decolecta) | decolecta | ninguno
RUC_DRIVER=openruc
# Consulta de DNI (RENIEC): decolecta | ninguno
DNI_DRIVER=decolecta
# Token gratuito de decolecta.com (cupo mensual compartido por RUC y DNI)
DECOLECTA_TOKEN=
