---
/** Logo de Serialo: engranaje y barras (mismo dibujo que el favicon del sistema). */
interface Props {
    class?: string;
}
const { class: clase = 'size-8' } = Astro.props;
const angulos = [0, 45, 90, 135, 180, 225, 270, 315];
---

<svg class={clase} viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="7" fill="#2558a8"></rect>
    <g fill="#7fcbe8">
        {
            angulos.map((a) => (
                <rect x="9.4" y="7.6" width="3.2" height="4.4" rx="0.7" transform={`rotate(${a} 11 16)`} />
            ))
        }
        <circle cx="11" cy="16" r="5.4"></circle>
    </g>
    <circle cx="11" cy="16" r="2.3" fill="#2558a8"></circle>
    <g fill="#ffffff">
        <rect x="20.4" y="9.5" width="1.6" height="13" rx="0.4"></rect>
        <rect x="23" y="9.5" width="0.9" height="13" rx="0.3"></rect>
        <rect x="24.8" y="9.5" width="1.9" height="13" rx="0.4"></rect>
        <rect x="27.5" y="9.5" width="0.9" height="13" rx="0.3"></rect>
    </g>
</svg>
