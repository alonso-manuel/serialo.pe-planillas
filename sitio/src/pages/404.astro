---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada · Serialo Planillas" descripcion="La página que buscas no existe.">
    <section class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6">
        <p class="text-sm font-semibold text-marca-600">Error 404</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight">Esta página no existe</h1>
        <p class="mt-4 text-slate-600">Si buscabas tu cuenta, entra con la dirección de tu estudio (por ejemplo, tu-estudio.impulso.cfd).</p>
        <a href="/" class="mt-8 inline-block rounded-xl bg-marca-600 px-6 py-3 font-semibold text-white hover:bg-marca-700">Ir al inicio</a>
    </section>
</Base>
