---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { enlaceWhatsapp, MENSAJE_DEMO, WHATSAPP_VISIBLE } from '../datos';

interface Props {
    titulo: string;
    descripcion: string;
}
const { titulo, descripcion } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const anio = new Date().getFullYear();
---

<!doctype html>
<html lang="es-PE">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{titulo}</title>
        <meta name="description" content={descripcion} />
        <link rel="canonical" href={canonica} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="theme-color" content="#2558a8" />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="es_PE" />
        <meta property="og:title" content={titulo} />
        <meta property="og:description" content={descripcion} />
        <meta property="og:url" content={canonica} />
        <link rel="preconnect" href="https://fonts.bunny.net" />
        <link
            rel="stylesheet"
            href="https://fonts.bunny.net/css?family=instrument-sans:400,500,600,700&display=swap"
        />
    </head>
    <body>
        <a
            href="#contenido"
            class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-white focus:px-3 focus:py-2"
            >Saltar al contenido</a
        >

        <header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur">
            <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
                <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
                    <Logo class="size-8" />
                    <span>Serialo <span class="text-marca-600">Planillas</span></span>
                </a>
                <div class="hidden items-center gap-7 text-sm text-slate-600 md:flex">
                    <a href="/#funciones" class="hover:text-marca-600">Funciones</a>
                    <a href="/#estudios" class="hover:text-marca-600">Para estudios</a>
                    <a href="/#seguridad" class="hover:text-marca-600">Seguridad</a>
                    <a href="/#preguntas" class="hover:text-marca-600">Preguntas</a>
                </div>
                <a
                    href="/#prueba"
                    class="rounded-lg bg-marca-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-marca-700"
                    >Prueba gratis</a
                >
            </nav>
        </header>

        <main id="contenido">
            <slot />
        </main>

        <footer class="border-t border-slate-200 bg-slate-50">
            <div
                class="mx-auto grid max-w-6xl gap-8 px-4 py-12 text-sm text-slate-600 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]"
            >
                <div>
                    <a href="/" class="flex items-center gap-2.5 font-semibold text-tinta">
                        <Logo class="size-7" />
                        Serialo Planillas
                    </a>
                    <p class="mt-3 max-w-sm">
                        Sistema de planillas para estudios contables y empresas del Perú. Desarrollado por Serialo.pe.
                    </p>
                </div>
                <div>
                    <p class="font-semibold text-tinta">Producto</p>
                    <ul class="mt-3 space-y-2">
                        <li><a href="/#funciones" class="hover:text-marca-600">Funciones</a></li>
                        <li><a href="/#estudios" class="hover:text-marca-600">Para estudios contables</a></li>
                        <li><a href="/#preguntas" class="hover:text-marca-600">Preguntas frecuentes</a></li>
                        <li><a href="/privacidad" class="hover:text-marca-600">Privacidad</a></li>
                    </ul>
                </div>
                <div>
                    <p class="font-semibold text-tinta">Contacto</p>
                    <ul class="mt-3 space-y-2">
                        <li>
                            <a href={enlaceWhatsapp(MENSAJE_DEMO)} class="hover:text-marca-600" rel="noopener"
                                >WhatsApp {WHATSAPP_VISIBLE}</a
                            >
                        </li>
                        <li><a href="/#prueba" class="hover:text-marca-600">Solicitar cuenta de prueba</a></li>
                    </ul>
                </div>
            </div>
            <p class="border-t border-slate-200 py-5 text-center text-xs text-slate-500">
                © {anio} Serialo.pe · Lima, Perú
            </p>
        </footer>

        <a
            href={enlaceWhatsapp(MENSAJE_DEMO)}
            rel="noopener"
            aria-label="Escríbenos por WhatsApp"
            class="fixed right-4 bottom-4 z-40 flex size-14 items-center justify-center rounded-full bg-[#25d366] text-white shadow-lg shadow-black/20 transition hover:scale-105 sm:right-6 sm:bottom-6"
        >
            <svg viewBox="0 0 24 24" class="size-7" fill="currentColor" aria-hidden="true">
                <path
                    d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2Zm5.8 14.15c-.24.68-1.43 1.32-1.97 1.37-.5.05-.98.24-3.3-.69-2.79-1.1-4.56-3.95-4.7-4.13-.13-.18-1.12-1.49-1.12-2.85 0-1.36.71-2.02.97-2.3.25-.28.55-.35.73-.35l.53.01c.17.01.4-.06.62.48.24.56.8 1.94.87 2.08.07.14.12.3.02.48-.09.18-.14.3-.28.46-.14.16-.29.36-.42.48-.14.14-.28.29-.12.57.16.28.72 1.19 1.55 1.93 1.06.95 1.96 1.24 2.24 1.38.28.14.44.12.6-.07.16-.19.69-.81.88-1.09.18-.28.37-.23.62-.14.25.09 1.62.76 1.9.9.28.14.46.21.53.33.07.12.07.68-.17 1.36Z"
                ></path>
            </svg>
        </a>
    </body>
</html>
