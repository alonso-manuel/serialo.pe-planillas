# .env del VPS (modo SaaS). instalar.sh lo copia a .env reemplazando {DOMINIO}, {DB_USUARIO} y {DB_CLAVE}.
# Completar a mano: MAIL_* y, si se usa, la copia externa de respaldos.
APP_NAME="Serialo Planillas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.{DOMINIO}
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=daily
LOG_LEVEL=warning

PLANILLAS_MODO=saas
PLANILLAS_DOMINIOS_CENTRALES={DOMINIO},admin.{DOMINIO}
PLANILLAS_DOMINIO_PANEL=admin.{DOMINIO}
PLANILLAS_URL_ESTUDIO=https://{estudio}.{DOMINIO}
PLANILLAS_PREFIJO_BD=planillas_
# La cola la atiende el servicio serialo-cola (no el cron de cada minuto)
PLANILLAS_COLA_PERMANENTE=true
PLANILLAS_RESPALDO_DIAS=14
PLANILLAS_RESPALDO_DISCO=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=serialo_central
DB_USERNAME={DB_USUARIO}
DB_PASSWORD={DB_CLAVE}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=planillas@{DOMINIO}
MAIL_FROM_NAME="Serialo Planillas"
